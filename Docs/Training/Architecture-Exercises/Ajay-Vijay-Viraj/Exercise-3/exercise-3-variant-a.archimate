    <element xsi:type="archimate:Driver" name="No context retention across turns" id="id-bbbc7df375d54494b8de64f8277578e8"/>
    <element xsi:type="archimate:Goal" name="Support natural multi-turn conversations" id="id-5dda4c1b6de64be3b4d684e3ef21fe2b"/>
