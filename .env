# =========================
# GLOBAL DEFAULTS
# =========================
# Used by CLI/scripts. Streamlit sidebar can override these at runtime.
LLM_PROFILE=local
EMBEDDING_PROFILE=local
VECTOR_STORE=chroma
TOP_K=5
CHUNK_TOKENS=650
OVERLAP_TOKENS=100

# =========================
# OLLAMA LOCAL MODE
# =========================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=gemma3n:e4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional fallback if 8 GB RAM is slow:
# OLLAMA_LLM_MODEL=gemma3:1b

# =========================
# AZURE CLOUD MODE
# =========================
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=replace-with-your-key
AZURE_OPENAI_CHAT_MODEL=gpt-5.4-nano
AZURE_OPENAI_EMBED_MODEL=text-embedding-3-small
